{
  "manifest_version": 3,
  "name": "Cardigan",
  "version": "0.34.11",
  "minimum_chrome_version": "111",
  "description": "Read-only look inside any Anaplan model or app: searchable tables and an interactive model map. Nothing leaves your browser.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Cardigan",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "content_scripts": [
    {
      "matches": ["https://*.app.anaplan.com/*", "https://*.app2.anaplan.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.app.anaplan.com/*", "https://*.app2.anaplan.com/*"],
      "js": ["dist/model-export.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
