{
  "manifest_version": 3,
  "name": "Anaplan Analyzer",
  "version": "0.5.4",
  "minimum_chrome_version": "111",
  "description": "Exports an Anaplan app's pages (cards, modules, filters, formatting, actions) and a model's Model settings as CSV files.",
  "content_scripts": [
    {
      "matches": ["https://*.app.anaplan.com/*", "https://*.app2.anaplan.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.app.anaplan.com/*", "https://*.app2.anaplan.com/*"],
      "js": ["dist/model-export.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
