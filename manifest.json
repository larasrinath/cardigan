{
  "manifest_version": 3,
  "name": "Cardigan",
  "version": "0.7.0",
  "minimum_chrome_version": "111",
  "description": "Shows an Anaplan app's pages (cards, modules, filters, formatting, actions) or a model's Model settings on a page, with CSV export.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Cardigan: analyse this Anaplan app or model",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.app.anaplan.com/*", "https://*.app2.anaplan.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.app.anaplan.com/*", "https://*.app2.anaplan.com/*"],
      "js": ["dist/model-export.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
